[Unit]
Description=Taskboard API (Flask + SQLite)
After=network.target

[Service]
Type=simple
User=taskboard
Group=taskboard
WorkingDirectory=/opt/taskboard
EnvironmentFile=-/etc/taskboard/env
ExecStart=/usr/bin/python3 -m flask --app /opt/taskboard/api.py run --host 127.0.0.1 --port 5050
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/taskboard
ReadOnlyPaths=/etc/taskboard
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
